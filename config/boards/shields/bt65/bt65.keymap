/*
 * BT65 68键键盘 - 默认按键映射
 * Nice!Nano (nRF52840) 主控
 *
 * 布局：68键 65% 配列
 *
 * 包含两层：
 *   基础层（Default Layer）- 标准按键输入
 *   Fn层（Fn Layer）      - 功能键、媒体控制、导航键
 *
 * ⚠️ 提示：此 keymap 对应 bt65.overlay 中定义的矩阵变换顺序
 *    如果矩阵引脚定义有修改，请同步更新此 keymap
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    /*
     * 键名别名定义（方便阅读和维护）
     * 使用标准的 HID 用法 ID
     */
    keymap_labels {
        /* 字母键 */
        Q = <&kp KP_Q>;
        W = <&kp KP_W>;
        E = <&kp KP_E>;
        R = <&kp KP_R>;
        T = <&kp KP_T>;
        Y = <&kp KP_Y>;
        U = <&kp KP_U>;
        I = <&kp KP_I>;
        O = <&kp KP_O>;
        P = <&kp KP_P>;
        A = <&kp KP_A>;
        S = <&kp KP_S>;
        D = <&kp KP_D>;
        F = <&kp KP_F>;
        G = <&kp KP_G>;
        H = <&kp KP_H>;
        J = <&kp KP_J>;
        K = <&kp KP_K>;
        L = <&kp KP_L>;
        Z = <&kp KP_Z>;
        X = <&kp KP_X>;
        C = <&kp KP_C>;
        V = <&kp KP_V>;
        B = <&kp KP_B>;
        N = <&kp KP_N>;
        M = <&kp KP_M>;

        /* 数字键 */
        N1 = <&kp KP_N1>;
        N2 = <&kp KP_N2>;
        N3 = <&kp KP_N3>;
        N4 = <&kp KP_N4>;
        N5 = <&kp KP_N5>;
        N6 = <&kp KP_N6>;
        N7 = <&kp KP_N7>;
        N8 = <&kp KP_N8>;
        N9 = <&kp KP_N9>;
        N0 = <&kp KP_N0>;

        /* 符号键 */
        GRAVE   = <&kp KP_GRAVE>;
        MINUS   = <&kp KP_MINUS>;
        EQUAL   = <&kp KP_EQUAL>;
        LBKT    = <&kp KP_LBKT>;
        RBKT    = <&kp KP_RBKT>;
        BSLH    = <&kp KP_BSLH>;
        SCLN    = <&kp KP_SCLN>;
        QUOT    = <&kp KP_QUOT>;
        COMMA   = <&kp KP_COMMA>;
        DOT     = <&kp KP_DOT>;
        FSLH    = <&kp KP_FSLH>;

        /* 功能键 */
        F1  = <&kp KP_F1>;
        F2  = <&kp KP_F2>;
        F3  = <&kp KP_F3>;
        F4  = <&kp KP_F4>;
        F5  = <&kp KP_F5>;
        F6  = <&kp KP_F6>;
        F7  = <&kp KP_F7>;
        F8  = <&kp KP_F8>;
        F9  = <&kp KP_F9>;
        F10 = <&kp KP_F10>;
        F11 = <&kp KP_F11>;
        F12 = <&kp KP_F12>;

        /* 控制键 */
        ESC  = <&kp KP_ESC>;
        TAB  = <&kp KP_TAB>;
        CAPS = <&kp KP_CAPS>;
        ENT  = <&kp KP_ENTER>;
        BSPC = <&kp KP_BSPC>;
        DEL  = <&kp KP_DEL>;
        INS  = <&kp KP_INS>;
        HOME = <&kp KP_HOME>;
        END  = <&kp KP_END>;
        PGUP = <&kp KP_PGUP>;
        PGDN = <&kp KP_PGDN>;

        /* 修饰键 */
        LCTL  = <&kp KP_LCTRL>;
        RCTL  = <&kp KP_RCTRL>;
        LALT  = <&kp KP_LALT>;
        RALT  = <&kp KP_RALT>;
        LGUI  = <&kp KP_LGUI>;
        RGUI  = <&kp KP_RGUI>;
        LSFT  = <&kp KP_LSHFT>;
        RSFT  = <&kp KP_RSHFT>;
        SPC   = <&kp KP_SPC>;

        /* 方向键 */
        UP    = <&kp KP_UP>;
        DOWN  = <&kp KP_DOWN>;
        LEFT  = <&kp KP_LEFT>;
        RIGHT = <&kp KP_RIGHT>;

        /* 媒体键 */
        MUTE    = <&kp KP_MUTE>;
        VOL_UP  = <&kp KP_VOL_UP>;
        VOL_DN  = <&kp KP_VOL_DN>;
        PLAY    = <&kp KP_PLAY>;
        PREV    = <&kp KP_PREV>;
        NEXT    = <&kp KP_NEXT>;

        /* 屏幕亮度 */
        BR_UP = <&kp KP_BRI_UP>;
        BR_DN = <&kp KP_BRI_DN>;

        /* 系统键 */
        PWR  = <&kp KP_SYSTEM_POWER>;
        SLEP = <&kp KP_SYSTEM_SLEEP>;
        WAKE = <&kp KP_SYSTEM_WAKE>;
    };

    /*
     * ===========================================================
     * 基础层（Layer 0）- 标准 68键 布局
     * ===========================================================
     *
     *    ┌───┬───┬───┬───┬───┬───┬───┬───┬───┬───┬───┬───┬───┬───────┬───┐
     *    │Esc│ 1 │ 2 │ 3 │ 4 │ 5 │ 6 │ 7 │ 8 │ 9 │ 0 │ - │ = │ Bspc  │ ` │
     *    ├───┴─┬─┴─┬─┴─┬─┴─┬─┴─┬─┴─┬─┴─┬─┴─┬─┴─┬─┴─┬─┴─┬─┴─┬─┴─┬─────┼───┤
     *    │ Tab │ Q │ W │ E │ R │ T │ Y │ U │ I │ O │ P │ [ │ ] │  \  │Del│
     *    ├─────┴┬──┴┬──┴┬──┴┬──┴┬──┴┬──┴┬──┴┬──┴┬──┴┬──┴┬──┴┬──┴─────┼───┤
     *    │ Caps │ A │ S │ D │ F │ G │ H │ J │ K │ L │ ; │ ' │ Enter  │PgU│
     *    ├──────┴─┬─┴─┬─┴─┬─┴─┬─┴─┬─┴─┬─┴─┬─┴─┬─┴─┬─┴─┬─┴─┬─┴────┬───┼───┤
     *    │ Shift  │ Z │ X │ C │ V │ B │ N │ M │ , │ . │ / │ Shift│ ↑ │PgD│
     *    ├────┬───┴┬──┴─┬─┴───┴───┴───┴───┴───┴──┬┴──┬┴──┬┴──┬───┼───┼───┤
     *    │Ctr│GUI │Alt │       Space             │Alt│ Fn│Ctr│ ← │ ↓ │ → │
     *    └────┴────┴────┴─────────────────────────┴───┴───┴───┴───┴───┴───┘
     */
    keymap0: keymap0 {
        compatible = "zmk,keymap";
        label = "Default Layer";

        bindings = <
    /* Row 0 (15键) */
    &kp KP_ESC  &kp KP_N1   &kp KP_N2   &kp KP_N3   &kp KP_N4   &kp KP_N5   &kp KP_N6
    &kp KP_N7   &kp KP_N8   &kp KP_N9   &kp KP_N0   &kp KP_MINUS &kp KP_EQUAL &kp KP_BSPC &kp KP_GRAVE

    /* Row 1 (15键) */
    &kp KP_TAB  &kp KP_Q    &kp KP_W    &kp KP_E    &kp KP_R    &kp KP_T    &kp KP_Y
    &kp KP_U    &kp KP_I    &kp KP_O    &kp KP_P    &kp KP_LBKT &kp KP_RBKT &kp KP_BSLH &kp KP_DEL

    /* Row 2 (15键) */
    &kp KP_CAPS &kp KP_A    &kp KP_S    &kp KP_D    &kp KP_F    &kp KP_G    &kp KP_H
    &kp KP_J    &kp KP_K    &kp KP_L    &kp KP_SCLN &kp KP_QUOT &kp KP_ENTER &kp KP_PGUP &kp KP_PGDN

    /* Row 3 (15键) */
    &kp KP_LSHFT &kp KP_Z   &kp KP_X    &kp KP_C    &kp KP_V    &kp KP_B    &kp KP_N
    &kp KP_M    &kp KP_COMMA &kp KP_DOT &kp KP_FSLH &kp KP_RSHFT &kp KP_UP  &kp KP_PGDN &kp KP_PGUP

    /* Row 4 (15键) */
    &kp KP_LCTRL &kp KP_LGUI &kp KP_LALT &kp KP_SPC &kp KP_SPC &kp KP_SPC &kp KP_SPC
    &kp KP_SPC   &kp KP_SPC  &kp KP_SPC  &kp KP_SPC  &kp KP_RALT &mo 1      &kp KP_RCTRL
    &kp KP_LEFT  &kp KP_DOWN &kp KP_RIGHT
        >;

        /* 传感器（编码器）绑定 - 本键盘无编码器，留空 */
        sensor-bindings = <>;
    };

    /*
     * ===========================================================
     * Fn 层（Layer 1）- 功能键和媒体控制
     * ===========================================================
     * 按住 Fn（位于右 Alt 和 右 Ctrl 之间）时激活
     *
     *   ┌────┬────┬────┬────┬────┬────┬────┬────┬────┬────┬────┬────┬────┬───────┬────┐
     *   │  ` │ F1 │ F2 │ F3 │ F4 │ F5 │ F6 │ F7 │ F8 │ F9 │F10 │F11 │F12 │       │Ins │
     *   ├────┴─┬──┴─┬──┴─┬──┴─┬──┴─┬──┴─┬──┴─┬──┴─┬──┴─┬──┴─┬──┴─┬──┴─┬──┴─┬─────┼────┤
     *   │      │    │    │    │    │    │    │    │    │    │Psc │Scl │Pau │     │    │
     *   ├──────┴┬───┴┬───┴┬───┴┬───┴┬───┴┬───┴┬───┴┬───┴┬───┴┬───┴┬───┴┬───┴─────┼────┤
     *   │       │    │    │    │    │    │    │    │    │    │    │    │         │    │
     *   ├───────┴─┬──┴─┬──┴─┬──┴─┬──┴─┬──┴─┬──┴─┬──┴─┬──┴─┬──┴─┬──┴─┬──┴────┬────┼────┤
     *   │         │    │    │    │    │    │    │    │    │    │    │       │Vol↑│Br↑ │
     *   ├────┬────┴┬───┴┬───┴────┴────┴────┴────┴────┴┬───┴┬───┴┬───┴┬────┬───┼────┼────┤
     *   │    │     │    │          Play/Pause         │    │    │    │Vol↓│Br↓│    │    │
     *   └────┴─────┴────┴─────────────────────────────┴────┴────┴────┴────┴───┴────┴────┘
     */
    keymap1: keymap1 {
        compatible = "zmk,keymap";
        label = "Fn Layer";

        bindings = <
&kp KP_GRAVE &kp KP_F1 &kp KP_F2 &kp KP_F3 &kp KP_F4 &kp KP_F5 &kp KP_F6 &kp KP_F7
&kp KP_F8 &kp KP_F9 &kp KP_F10 &kp KP_F11 &kp KP_F12 &kp KP_DEL &kp KP_INS

&out OUT_TOG &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &bt BT_SEL 5
&trans &trans &trans &kp KP_PSCR &kp KP_SLCK &kp KP_PAUS &bt BT_CLR &trans

&trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &kp KP_HOME &kp KP_END

/* Row3:  Z    X    C          V          B          N          M         ,      .      /   RShift     ↑        ↓      PgDn */
&trans &trans &trans &rgb_pwr TOGGLE &rgb_ug RGB_EFF &rgb_ug RGB_EFR &rgb_ug RGB_HUI &rgb_ug RGB_HUD
&trans &trans &trans &trans &kp KP_VOL_UP &kp KP_VOL_DN &kp KP_BRI_UP

&trans &trans &trans &kp KP_PLAY &kp KP_PLAY &kp KP_PLAY &kp KP_PLAY
&kp KP_PLAY &kp KP_PLAY &kp KP_PLAY &kp KP_PLAY &trans &trans &trans
&kp KP_PREV &kp KP_MUTE &kp KP_NEXT
        >;

        sensor-bindings = <>;
    };
};
